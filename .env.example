# Copy to .env and fill in. Never commit the real .env file.

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to "development" to allow a throwaway SECRET_KEY for local work.
FLASK_ENV=development

# Storage
UPLOAD_FOLDER=storage/uploads
OUTPUT_FOLDER=storage/outputs
MAX_CONTENT_LENGTH=524288000

# Files are deleted this many minutes after creation.
AUTO_DELETE_AFTER_MINUTES=30
CLEANUP_INTERVAL_SECONDS=300

# Optional: explicit binary paths. Left blank, they are found on PATH.
FFMPEG_BIN=
FFPROBE_BIN=

# Stream-copy instead of re-encoding. Much faster, cuts land on keyframes.
FAST_MODE=False

# Concurrent FFmpeg jobs. Keep low on small instances; each one is CPU-bound.
MAX_CONCURRENT_JOBS=4

# Hard ceiling on a single FFmpeg run, in seconds.
FFMPEG_TIMEOUT_SECONDS=1800

# /stats exposes RAM, CPU, disk and queue depth. Off by default.
# Set a token to allow access via ?token=... or the X-Stats-Token header.
STATS_PUBLIC=false
STATS_TOKEN=

# Rate limits. Use a Redis URI when running more than one worker/instance,
# otherwise each process counts separately.
RATELIMIT_STORAGE_URI=memory://
PROCESSING_RATE_LIMIT=20 per hour;5 per minute
UPLOAD_RATE_LIMIT=30 per hour;10 per minute
